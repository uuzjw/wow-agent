# wow-agent 配置示例：复制为 .env 并填入你的 key
WOW_API_KEY=sk-xxxx
WOW_BASE_URL=https://api.deepseek.com/v1
WOW_MODEL=deepseek-chat

# 可选：上下文超过该估算 token 数时自动压缩历史（默认 55000）
# WOW_AUTO_COMPACT=55000

# 可选：外传防护，1=开（默认） 0=关；会话内 /safe 随时切换。
# 开启时 git push / scp / curl POST 等上传外发命令任何模式都强制批准，
# 联网查资料、下载、装包不受影响
# WOW_UPLOAD_GUARD=1
