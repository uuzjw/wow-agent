{% set isZh = currentUrlPath.startsWith('/zh') %}
{% set DOC_PREFIX = ['/guide', '/architecture', '/tools', '/safety', '/config', '/tutorials', '/cli', '/why', '/comparison', '/changelog'] %}
{% set isDoc = false %}
{% for pre in DOC_PREFIX %}{% if currentUrlPath.startsWith(pre) %}{% set isDoc = true %}{% endif %}{% endfor %}
{% set enPath = currentUrlPath.slice(3) %}
{% if enPath == '/home/' or enPath == '' %}{% set enPath = '/' %}{% endif %}
{% if not enPath.startsWith('/') %}{% set enPath = '/' %}{% endif %}
{% if currentUrlPath == '/' %}{% set zhPath = '/zh/home/' %}{% elseif isDoc %}{% set zhPath = '/zh' + currentUrlPath %}{% else %}{% set zhPath = '/zh/home/' %}{% endif %}
<header class="site-header">
  <div class="shell header-inner">
    {% if isZh %}
      <a class="brand" href="{{ href('/zh/home/', currentUrlPath) }}">
    {% else %}
      <a class="brand" href="{{ href('/', currentUrlPath) }}">
    {% endif %}
      <img class="brand-logo" src="{{ href('/assets/logo.png', currentUrlPath) }}" alt="wow-agent logo" width="34" height="34" />
      <span class="brand-name">wow-agent</span>
    </a>
    <nav class="top-nav" aria-label="Primary">
      {% if isZh %}
        <a class="top-nav__link" href="{{ href('/zh/guide/', currentUrlPath) }}">指南</a>
        <a class="top-nav__link" href="{{ href('/zh/architecture/', currentUrlPath) }}">架构</a>
        <a class="top-nav__link" href="{{ href('/zh/tools/', currentUrlPath) }}">工具</a>
        <a class="top-nav__link" href="{{ href('/zh/safety/', currentUrlPath) }}">安全</a>
        <a class="top-nav__link" href="{{ href('/zh/config/', currentUrlPath) }}">配置</a>
        <a class="top-nav__link top-nav__lang" href="{{ href(enPath, currentUrlPath) }}" title="Switch to English">EN</a>
      {% else %}
        <a class="top-nav__link" href="{{ href('/guide/', currentUrlPath) }}">Guide</a>
        <a class="top-nav__link" href="{{ href('/architecture/', currentUrlPath) }}">Architecture</a>
        <a class="top-nav__link" href="{{ href('/tools/', currentUrlPath) }}">Tools</a>
        <a class="top-nav__link" href="{{ href('/safety/', currentUrlPath) }}">Safety</a>
        <a class="top-nav__link" href="{{ href('/config/', currentUrlPath) }}">Config</a>
        <a class="top-nav__link top-nav__lang" href="{{ href(zhPath, currentUrlPath) }}" title="切换到中文">中文</a>
      {% endif %}
      <button class="theme-toggle" id="wow-theme-toggle" aria-label="Toggle theme">☾</button>
    </nav>
  </div>
</header>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var btn = document.getElementById("wow-theme-toggle");
    if (!btn) return;
    var root = document.documentElement;
    function sync() {
      btn.textContent = root.dataset.theme === "dark" ? "☀" : "☾";
    }
    sync();
    btn.addEventListener("click", function () {
      root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
      localStorage.setItem("wow-theme", root.dataset.theme);
      sync();
    });
  });
</script>
